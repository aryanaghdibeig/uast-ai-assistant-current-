# =====================================================
# OpenRouter
# =====================================================

OPENROUTER_API_KEY=your_openrouter_api_key

OPENROUTER_SITE_URL=https://your-domain.com

OPENROUTER_APP_TITLE=UAST AI Assistant


# =====================================================
# AI Development Mode
# =====================================================

MOCK_AI=true


# =====================================================
# Supabase Public Variables
# =====================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key


# =====================================================
# Supabase Server Secret
# =====================================================

SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key


# =====================================================
# Diagnostic routes (local only — P0-B2)
# =====================================================
# /api/supabase-test is blocked in production (proxy + route).
# Even in development it requires:
#   1) an authenticated session
#   2) ALLOW_SUPABASE_TEST=true
# Leave unset (or false) unless you intentionally need this probe.
# ALLOW_SUPABASE_TEST=true


# =====================================================
# Supabase CLI (local tooling only — P0-A1)
# =====================================================
# Not read by the Next.js app. Used when linking the CLI:
#   npx supabase login
#   npx supabase link --project-ref <ref>
# Project ref is the id in https://<ref>.supabase.co
# Do not commit access tokens. Prefer `supabase login` over storing
# SUPABASE_ACCESS_TOKEN in files.
#
# Type generation (after link / local start):
#   npm run db:types
#   npm run db:types:local
# Output: types/database.generated.ts (created in P0-A2 after schema verify)


# =====================================================
# Embeddings
# =====================================================

EMBEDDING_MODEL=openai/text-embedding-3-small

EMBEDDING_DIMENSIONS=1536

MOCK_EMBEDDINGS=true


# ==============================
# Demo Release Settings
# ==============================

DEMO_MODE=true

# Free mode must never use paid fallback
DEMO_FREE_MODEL=openrouter/free
DEMO_DISABLE_PAID_FALLBACK_FOR_FREE=true

# Main demo model for managers
# This can be changed later from the model catalog.
DEMO_MAIN_MODEL=openai/gpt-4o-mini

# Follow-up suggestions should be cheap or template-based
DEMO_FOLLOWUP_ACTIONS_MODE=template
DEMO_FOLLOWUP_MODEL=openrouter/free

# Token limits for demo
DEMO_MAX_OUTPUT_TOKENS_FREE=700
DEMO_MAX_OUTPUT_TOKENS_MAIN=1200
DEMO_MAX_OUTPUT_TOKENS_ADVANCED=1800

# Demo usage control
DEMO_DAILY_FREE_MESSAGES=20
DEMO_MONTHLY_FREE_CREDITS=100