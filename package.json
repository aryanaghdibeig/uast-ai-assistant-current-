{
  "name": "my-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:security-static": "node scripts/verify-security-static.mjs",
    "verify:idempotency": "node --experimental-strip-types scripts/verify-idempotency.mjs",
    "verify:chat-limits": "node --experimental-strip-types scripts/verify-chat-limits.mjs",
    "verify:local": "npm run verify:security-static && npm run verify:idempotency && npm run verify:chat-limits",
    "knowledge:index": "npx tsx --env-file=.env.local scripts/index-org-knowledge.mts",
    "verify:db-roles": "node --experimental-strip-types scripts/run-db-role-tests.mjs",
    "db:link": "node -e \"console.log('Run: npx supabase login && npx supabase link --project-ref <YOUR_PROJECT_REF>')\"",
    "db:pull": "npx supabase db pull",
    "db:types": "npx supabase gen types typescript --local --schema public > types/database.generated.ts",
    "db:types:local": "npx supabase gen types typescript --local --schema public > types/database.generated.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-presence": "^1.1.10",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tsparticles/engine": "^4.4.0",
    "@tsparticles/react": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.0",
    "next": "16.2.4",
    "openai": "^6.35.0",
    "pdf-parse": "^2.4.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
