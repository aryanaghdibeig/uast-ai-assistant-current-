{
  "name": "my-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:link": "node -e \"console.log('Run: npx supabase login && npx supabase link --project-ref <YOUR_PROJECT_REF>')\"",
    "db:pull": "npx supabase db pull",
    "db:types": "npx supabase gen types typescript --local --schema public > types/database.generated.ts",
    "db:types:local": "npx supabase gen types typescript --local --schema public > types/database.generated.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "16.2.4",
    "openai": "^6.35.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "undici": "^8.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
